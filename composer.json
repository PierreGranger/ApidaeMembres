{
    "name": "pierre-granger/apidae-membres",
    "description": "Classe d'utilisation des API membres & utilisateurs d'Apidae ",
    "require": {
        "php": "^8.4",
        "pierre-granger/apidae-core": "^0.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PierreGranger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PierreGranger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
